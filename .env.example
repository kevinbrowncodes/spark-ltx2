# Copy to .env (gitignored). docker-compose reads these.

# Where the LTX-2.3 weights live on the host (mounted read-only at /models).
# Defaults in docker-compose.yml point at ~/ltx2/models — override if needed.
# MODELS_DIR=/home/kevinbrown/ltx2/models

# Render output dir on the host.
# OUTPUT_DIR=/home/kevinbrown/ltx2/output

# Source images for I2V (LoadImage reads from here).
# INPUT_DIR=/home/kevinbrown/Documents/cosmos-media

# How long the API waits for a render before returning 504 (seconds).
# LTX_POLL_TIMEOUT_S=1800

# NOTE: This stack uses the fully LOCAL Gemma text encoder, so NO LTX cloud
# API key is required. (The cloud path via api.ltx.video is intentionally
# not used.)
