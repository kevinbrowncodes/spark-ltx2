# Containerized ComfyUI + official LTX-2.3 nodes, built for the DGX Spark's
# GB10 Grace-Blackwell GPU (compute capability sm_121 / 12.1a). Fully
# self-contained: does NOT touch the host ComfyUI on :8188.
#
# WHY THIS IS NOT THE NGC PyTorch IMAGE:
# The NGC pytorch:25.12 image ships an alpha torch (2.10.0a0) whose compiled
# kernels stop at sm_120 — it has NO native sm_121 kernels for the GB10. Running
# LTX-2.3 through sm_120 forward-compat produces subtly wrong numerics: the
# video comes out gray / desaturated (SATAVG ~6 vs a normal 30-80), not a crash.
# Every known-good DGX Spark LTX image fixes this the same way: stable cu130
# torch + SageAttention compiled natively for sm_121a. This recipe mirrors
# AEON-7/comfyui-aeon-spark and ecarmen16/SparkyUI.
FROM nvidia/cuda:13.0.2-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-dev python3-pip \
      git ffmpeg ninja-build build-essential tini \
 && rm -rf /var/lib/apt/lists/*

# Isolated venv so we never fight Ubuntu's PEP-668 system Python.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip wheel setuptools

# Stable cu130 torch stack that targets Blackwell. On cu130 the real torchaudio
# works, so (unlike the NGC build) we need no torchaudio stub.
RUN pip install --index-url https://download.pytorch.org/whl/cu130 \
      torch==2.9.1+cu130 torchvision==0.24.1 torchaudio==2.9.1

# Freeze the torch stack into a constraints file so ComfyUI + custom-node
# installs can't clobber it with an incompatible wheel.
RUN python - <<'PY' > /tmp/torch-constraints.txt
import torch, torchvision, torchaudio
print(f"torch=={torch.__version__}")
print(f"torchvision=={torchvision.__version__}")
print(f"torchaudio=={torchaudio.__version__}")
PY
RUN echo "=== torch constraints ===" && cat /tmp/torch-constraints.txt

# --- SageAttention, compiled natively for the GB10 (sm_121a) ---------------
# This is THE fix for the gray/desaturated output: native attention kernels for
# compute capability 12.1a instead of sm_120 forward-compat. ComfyUI picks it up
# at runtime via the --use-sage-attention flag.
ENV TORCH_CUDA_ARCH_LIST="12.1a"
ENV NVCC_APPEND_FLAGS="-gencode=arch=compute_121a,code=sm_121a -gencode=arch=compute_121,code=sm_121"
RUN git clone --depth=1 https://github.com/thu-ml/SageAttention.git /opt/SageAttention \
 && cd /opt/SageAttention \
 && pip wheel --no-build-isolation -w /wheels . \
 && pip install /wheels/sageattention*.whl

# --- ComfyUI core ----------------------------------------------------------
WORKDIR /opt
RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI.git
WORKDIR /opt/ComfyUI
RUN pip install -r requirements.txt -c /tmp/torch-constraints.txt

# --- Official Lightricks LTX-2 nodes + RES4LYF samplers --------------------
# RES4LYF provides ClownSampler_Beta / ManualSigmas used by the 2.3 workflow.
WORKDIR /opt/ComfyUI/custom_nodes
RUN git clone --depth 1 https://github.com/Lightricks/ComfyUI-LTXVideo.git \
 && git clone --depth 1 https://github.com/ClownsharkBatwing/RES4LYF.git
RUN pip install -r ComfyUI-LTXVideo/requirements.txt -c /tmp/torch-constraints.txt
RUN pip install -r RES4LYF/requirements.txt -c /tmp/torch-constraints.txt || \
    echo "WARN: RES4LYF requirements partially failed; verify samplers load in logs"

# ComfyUI-LTXVideo imports pyramid helpers (pad/is_powerof_two/...) that newer
# kornia (0.8.x) removed. 0.7.4 is the newest kornia that still exports them.
RUN pip install "kornia==0.7.4" -c /tmp/torch-constraints.txt

WORKDIR /opt/ComfyUI
# Grace-Blackwell coherent unified memory: disable torch.compile/dynamo (would
# JIT-fail on sm_121a) and use expandable segments.
ENV TORCH_COMPILE_DISABLE=1
ENV TORCHDYNAMO_DISABLE=1
ENV PYTORCH_ALLOC_CONF=expandable_segments:True
EXPOSE 8188
# Launch flags live in docker-compose.yml so they can be tuned without a rebuild.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188"]
